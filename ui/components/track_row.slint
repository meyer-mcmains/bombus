import { Track, Theme, Logic } from "../global.slint";
import { Body, BodySmallMono } from "../typography.slint";
import { VerticalBox } from "std-widgets.slint";

export component TrackRow inherits Rectangle {
    in property <Track> track;
    property <length> left-right-padding: 8px;
    background: touch.has-hover ? Theme.color.system-blue : Theme.color.system-fill-tertiary;
    border-radius: 8px;
    animate background {
        duration: 250ms;
        easing: ease-in-out;
    }

    HorizontalLayout {
        padding-left: left-right-padding;
        padding-right: left-right-padding;
        alignment: space-between;

        HorizontalLayout {
            HorizontalLayout {
                spacing: 6px;
                padding-right: 10px;

                BodySmallMono {
                    color: touch.has-hover ? Theme.color.system-white : Theme.color.label-secondary;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    text: track.number;
                    width: 18px;
                    animate color {
                        duration: 250ms;
                        easing: ease-in-out;
                    }
                }

                Rectangle {
                    y: 6px;
                    height: parent.height - 12px;
                    width: 2px;
                    background: Logic.now-playing-track.uri == track.uri ? Theme.color.system-blue : Theme.color.separator;
                    border-radius: 2px;
                }
            }

            Body {
                vertical-alignment: center;
                horizontal-alignment: left;
                overflow: elide;
                text: track.title;
            }
        }

        HorizontalLayout {
            padding-left: 8px;

            BodySmallMono {
                color: touch.has-hover ? Theme.color.system-white : Theme.color.label-secondary;
                vertical-alignment: center;
                horizontal-alignment: left;
                text: track.length;
                animate color {
                    duration: 250ms;
                    easing: ease-in-out;
                }
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => Logic.track-clicked(track);
    }
}
